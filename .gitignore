__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

# Generated KB artifacts (rebuild with `python scripts/build_kb.py`)
kb/build/*.json
kb/build/*.jsonl

# Model run outputs (large, regenerable)
data/runs/**/raw/
*.log

# Secrets
.env
*.key

# Working directories, not artifacts.
# NOTE: gitignore has no trailing-comment syntax — a comment after a pattern on the same
# line becomes part of the pattern and silently matches nothing. Keep comments on their
# own lines.
.trash/
# gold-set baselines for scripts/gold_diff.py
.snapshots/
# fetched source bodies, kept as retrieval evidence
.cache/
.DS_Store
.claude/launch.json
# Saved citizen profiles and their uploaded documents — personal data, never committed.
data/vault/
# Browser test screenshots (tests/test_ui.py)
ui-screenshots/
